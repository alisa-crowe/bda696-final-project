import pandas as pd

# Load your cleaned dataset
df = pd.read_csv("../reddit_team_data.csv")

# Extract the year from the timestamp
df["year"] = pd.to_datetime(df["created_utc"]).dt.year

# Get unique (team, year) combinations
team_years = (
    df[["matched_keyword", "year"]]
    .drop_duplicates()
    .sort_values(["matched_keyword", "year"])
)

# Print results to terminal
print("Unique team–year combinations:\n")
for _, row in team_years.iterrows():
    print(f"{row['matched_keyword']} - {row['year']}")

print(f"\nTotal combinations: {len(team_years)}")
