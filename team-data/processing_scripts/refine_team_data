print("Filtering non-human-like posts...")
df = df[df["text"].progress_apply(looks_human)]

print("Filtering bot-style or automated posts...")
def has_bot_signature(text):
    patterns = [
        r"posted by", r"via ", r"bot$", r"auto[- ]post",
        r"scheduled tweet", r"rss feed", r"bufferapp", r"hootsuite"
    ]
    txt = str(text).lower()
    return any(re.search(p, txt) for p in patterns)

df = df[~df["text"].progress_apply(has_bot_signature)]

print("Filtering low alphabetic density posts...")
df = df[df["text"].apply(lambda x: sum(c.isalpha() for c in str(x)) / max(len(str(x)),1) > 0.5)]

print("Filtering excessive emoji/punctuation repetition...")
def excessive_emojis_or_punct(text):
    return bool(re.search(r'([!?😂🔥⭐️])\1{2,}', str(text)))
df = df[~df["text"].progress_apply(excessive_emojis_or_punct)]

