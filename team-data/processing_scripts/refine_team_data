        return False
    lower = text.lower()
    return any(term in lower for term in baseball_terms)


# === EXTRA QUALITY FILTERS ===

def too_short(text):
    return len(str(text).split()) < 5   # adjust to 8 for stricter filtering

def low_information(text):
    words = str(text).split()
    unique_ratio = len(set(words)) / max(len(words), 1)
    return unique_ratio < 0.4

def too_many_hashtags_or_caps(text):
    tokens = str(text).split()
    if len(tokens) == 0:
        return True
    hashtags = sum(1 for t in tokens if t.startswith("#"))
    hashtag_ratio = hashtags / len(tokens)
    caps_ratio = sum(1 for c in text if c.isupper()) / max(len(text), 1)
    return hashtag_ratio > 0.3 or caps_ratio > 0.7

def looks_like_scoreboard(text):
    txt = str(text).lower()
    return bool(re.search(r'\b\d+\s*[-–]\s*\d+\b', txt)) and "final" in txt

def looks_human(text):
    txt = str(text)
    url_count = txt.lower().count("http")
    emoji_count = len(re.findall(r"[^\w\s,.!?]", txt))
    return (url_count == 0) and (emoji_count / max(len(txt), 1) < 0.2)


