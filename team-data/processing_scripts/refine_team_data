df = df.drop_duplicates()

# === FILTER DEFINITIONS ===

def is_nonsense(text):
    if not isinstance(text, str) or len(text.strip()) == 0:
        return True
    cleaned = re.sub(r'[^A-Za-z0-9\s]', '', text)
    words = cleaned.split()
    return len(words) < 3 or all(len(w) <= 2 for w in words)

def too_few_letters(text):
    letters = re.findall(r'[A-Za-z]', text)
    return len(letters) / max(len(text), 1) < 0.3

def link_or_mention_heavy(text):
    tokens = text.split()
    if len(tokens) == 0:
        return True
    url_like = sum(1 for t in tokens if "http" in t or "@" in t or "#" in t)
    return url_like / len(tokens) > 0.3

def looks_like_gibberish(text):
    return bool(re.search(r'(.)\\1{4,}', text)) or bool(re.search(r'^[a-z]{10,}$', text, re.I))

def not_english(text):
    try:
        return detect(text) != "en"
    except:
        return True

def has_too_many_nonascii(text):
    non_ascii = sum(1 for c in str(text) if ord(c) > 127)
    return non_ascii / max(len(str(text)), 1) > 0.2

def is_promotional(text):
    if not isinstance(text, str):
        return False
    promo_patterns = [
        r"^(\W|\s)*new\s+episode",
        r"^(\W|\s)*new\s+article",
        r"^(\W|\s)*new\s+podcast",
        r"^(\W|\s)*check\s+out\s+our\s+latest",
        r"^(\W|\s)*listen\s+now",
    ]
    for pat in promo_patterns:
        if re.search(pat, text, re.IGNORECASE):
            return True
    return False


