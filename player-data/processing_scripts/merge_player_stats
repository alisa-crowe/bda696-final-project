import pandas as pd
import re

# --- Normalize names function ---
def normalize_name(name):
    """Standardize player names so merge keys match across datasets."""
    if pd.isna(name):
        return name
    name = str(name).lower()
    name = re.sub(r"[.'’-]", "", name)
    name = re.sub(r"[^a-z\s]", "", name)
    name = re.sub(r"\s+", " ", name).strip()
    return name.title()

# --- Load datasets ---
reddit = pd.read_csv("../reddit_player_data_with_team_stats.csv")
player_stats = pd.read_csv("../player_stats_2025.csv")  # or whatever your fetch script saved

# --- Normalize merge keys ---
reddit["player_name_norm"] = reddit["matched_players_auto"].apply(normalize_name)
player_stats["player_name_norm"] = player_stats["player_name"].apply(normalize_name)

# --- Merge ---
merged = reddit.merge(player_stats, on="player_name_norm", how="left")

# --- Save ---
merged.to_csv("../reddit_player_data_with_player_stats.csv", index=False)
print(" Merged player-level stats into Reddit dataset.")
