import pandas as pd
import re
import unidecode

# --- Define normalization function ---
def normalize_name(name):
    """Cleans and standardizes player names for consistent matching."""
    if pd.isna(name):
        return name

    name = str(name).strip()

    # Handle initials like "A.J." or "A. J." -> "AJ"
    name = re.sub(r"\b([A-Za-z])\.\s?([A-Za-z])\.", r"\1\2", name)
    name = re.sub(
        r"\b([A-Za-z])\s+([A-Za-z])\b(?=\s|$)",
        lambda m: m.group(1) + m.group(2)
        if len(m.group(0).strip()) == 3
        else m.group(0),
        name,
    )

    # Remove punctuation except spaces
    name = re.sub(r"[^A-Za-z\s]", "", name)

    # Collapse multiple spaces
    name = re.sub(r"\s+", " ", name)

    # Normalize accented characters (e.g., "José" -> "Jose")
    name = unidecode.unidecode(name)

    # Capitalize each word
    name = " ".join(word.capitalize() for word in name.split())

    return name


# --- Load roster dataset ---
roster_path = "../team_rosters_cleaned.xlsx"
print(f"Loading {roster_path} ...")
roster_df = pd.read_excel(roster_path)

# Ensure player_name column exists
if "player_name" not in roster_df.columns:
    raise ValueError("The roster file must have a 'player_name' column.")

# --- Create normalized_name column ---
roster_df["normalized_name"] = roster_df["player_name"].apply(normalize_name)

# --- Preview sample ---
print("\nSample before/after normalization:")
print(roster_df[["player_name", "normalized_name"]].head(10))

# --- Save updated file ---
roster_df.to_excel(roster_path, index=False)
print(f"\n Updated {roster_path} with 'normalized_name' column.")
