# --- Merge team stats into player dataset ---
print("\nMerging team stats into player dataset...")
merged = players.merge(team_stats_df, on="team_name_norm", how="left")

# --- Check resulting columns ---
print("\nMerged dataset columns (preview):")
print([c for c in merged.columns if c.startswith("team_")][:10])

# --- Validate merged content ---
print("\nSample of merged team stats:")
print(merged.filter(like="team_").head(5))

# --- Save final dataset ---
merged.to_csv(output_path, index=False)
