# --- Normalize team names for consistency ---
def normalize_team_name(name):
    if pd.isna(name):
        return name
    name = str(name).strip().lower()
    name = re.sub(r"[^a-z\s]", "", name)
    name = re.sub(r"\s+", " ", name)
    return name.title()

players["team_name_norm"] = players["team_name"].apply(normalize_team_name)
roster["team_name_norm"] = roster["team_name"].apply(normalize_team_name)

