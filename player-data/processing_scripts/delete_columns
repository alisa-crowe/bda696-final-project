#!/usr/bin/env python3
import csv
import os
import tempfile

def trim_last_three_columns_inplace(input_path: str):
    if not os.path.isfile(input_path):
        print(f"Error: '{input_path}' not found.")
        return

    # Create a temporary file in the same directory
    dir_name = os.path.dirname(os.path.abspath(input_path))
    fd, tmp_path = tempfile.mkstemp(prefix="trimmed_", suffix=".csv", dir=dir_name)
    os.close(fd)

    try:
        with open(input_path, "r", newline="", encoding="utf-8", errors="replace") as fin, \
             open(tmp_path, "w", newline="", encoding="utf-8") as fout:

            reader = csv.reader(fin)
            writer = csv.writer(fout, lineterminator="\n")

            header = next(reader, None)
            if not header:
                print("Error: CSV is empty.")
                os.remove(tmp_path)
                return

            if len(header) < 3:
                print(f"Error: CSV has only {len(header)} columns; cannot remove 3.")
                os.remove(tmp_path)
                return

            keep = len(header) - 3
            writer.writerow(header[:keep])

            for row in reader:
                row = (row + [""] * (len(header) - len(row)))[:len(header)]
                writer.writerow(row[:keep])

        os.replace(tmp_path, input_path)
        print(f" Success: Trimmed last 3 columns from {input_path}")
    except Exception as e:
        os.remove(tmp_path)
        raise e

if __name__ == "__main__":
    trim_last_three_columns_inplace("../reddit_player_data.csv")
