import pandas as pd
import re
import torch
from sentence_transformers import SentenceTransformer, util
from collections import Counter
import matplotlib.pyplot as plt
from time import time

# --- File paths ---
reddit_path = "../reddit_player_data.csv"
roster_path = "../team_rosters_cleaned.xlsx"
output_path = "../reddit_player_data_matched_embeddings_batched_1to3.csv"

# --- Load data ---
reddit_df = pd.read_csv(reddit_path)
roster_df = pd.read_excel(roster_path)

# --- Normalize roster names if needed ---
if "normalized_name" not in roster_df.columns:
    def normalize_name(name):
        name = str(name).lower()
        name = re.sub(r"[.'’-]", "", name)
        name = re.sub(r"[^a-z\s]", "", name)
        name = re.sub(r"\s+", " ", name).strip()
        return name.title()
    roster_df["normalized_name"] = roster_df["player_name"].apply(normalize_name)

roster_names = roster_df["normalized_name"].dropna().unique().tolist()
print(f"{len(roster_names)} roster names loaded.")

# --- Load SentenceTransformer model ---
device = "cuda" if torch.cuda.is_available() else "cpu"
model = SentenceTransformer("all-MiniLM-L6-v2", device=device)
print(f"Using device: {device}")

# --- Precompute roster embeddings ---
print("Encoding roster names...")
roster_embs = model.encode(roster_names, convert_to_tensor=True, normalize_embeddings=True)

# --- Candidate extractor (inclusive) ---
def extract_name_candidates(text):
    if pd.isna(text):
        return []
    pattern = r"\b([A-Za-z][A-Za-z'’\-]+(?:\s+[A-Za-z][A-Za-z'’\-]+){0,2})\b"
    cands = re.findall(pattern, text)
    return list(set([c.strip() for c in cands if 2 <= len(c) <= 40]))

# --- Matching in batch per post ---
def batched_match(candidates, threshold=0.60):
    """Match all candidates for one post at once using cosine similarity."""
    if not candidates:
        return []
    cand_embs = model.encode(candidates, convert_to_tensor=True, normalize_embeddings=True)
    sims = util.cos_sim(cand_embs, roster_embs)
    best_scores, best_indices = torch.max(sims, dim=1)

    matches = []
    for i, score in enumerate(best_scores):
        score_val = float(score)
        if score_val >= threshold:
            matches.append((candidates[i], roster_names[int(best_indices[i])], round(score_val, 3)))
    return matches

# --- Main loop ---
matched_rows = []
player_count_summary = []
save_every = 1000  # autosave every 1000 posts
start_time = time()

for i, row in enumerate(reddit_df.itertuples(index=False), start=1):
    text = str(row.text)
    candidates = extract_name_candidates(text)
    matched = batched_match(candidates)
    n = len(matched)
    player_count_summary.append(n)

    #  New rule: skip posts with more than 3 matched players
    if n == 0 or n > 3:
        continue

    # keep 1–3 player posts, duplicating rows per player
    for cand, m, s in matched:
        row_dict = row._asdict()
        row_dict["matched_players_auto"] = m
        row_dict["match_confidences"] = s
        matched_rows.append(row_dict)

    # Periodic progress updates
    if i % 100 == 0:
        elapsed = time() - start_time
        print(f"Processed {i}/{len(reddit_df)} posts ({elapsed/60:.1f} min elapsed)")

    if i % save_every == 0:
        pd.DataFrame(matched_rows).to_csv(output_path, index=False)
        print(f"Autosaved progress at {i} posts.")

# --- Final save ---
expanded_df = pd.DataFrame(matched_rows)
expanded_df.to_csv(output_path, index=False)
print(f"\n Finished! Results saved to {output_path}")

# --- Summary ---
total_original = len(reddit_df)
total_final = len(expanded_df)
print(f"Original posts: {total_original}")
print(f"Final rows (player-level, 1–3 players per post): {total_final}")
print(f"Retention rate: {(total_final / total_original) * 100:.2f}%")

# --- Histogram ---
mention_counts = Counter(player_count_summary)
for n in sorted(mention_counts.keys()):
    print(f"{n:>3} players mentioned: {mention_counts[n]} posts")

plt.bar(mention_counts.keys(), mention_counts.values())
plt.xlabel("Players mentioned per post")
plt.ylabel("Posts")
plt.title("Distribution of player mentions per post (1–3 player posts kept)")
plt.show()
