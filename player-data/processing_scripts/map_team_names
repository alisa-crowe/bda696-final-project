import pandas as pd

# Load data
players = pd.read_csv("../reddit_player_data_matched_embeddings_batched_1to3.csv")
roster = pd.read_excel("../team_rosters_cleaned.xlsx")

# Keep only relevant columns from roster
roster_lookup = roster[["normalized_name", "team_name"]]

# Merge team info
merged = players.merge(roster_lookup,
                       left_on="matched_players_auto",
                       right_on="normalized_name",
                       how="left")

# Drop duplicate merge key
merged.drop(columns=["normalized_name"], inplace=True)

# Check sample
print(merged[["matched_players_auto", "team_name"]].head(10))

# Save new version
merged.to_csv("../reddit_player_data_with_teams.csv", index=False)
print(" Added team_name column and saved to reddit_player_data_with_teams.csv")
