import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score, mean_squared_error


def main():
    df = pd.read_csv("team_data_with_themes_final.csv")
    df["team"] = df["matched_keyword"]

    # Only baseball performance stats (no sentiment/emotion/theme variables)
    team_stat_cols = [
        "team_AVG", "team_BB_per_9", "team_E", "team_ERA", "team_FldPct",
        "team_HR", "team_K_per_9", "team_OBP", "team_OPS", "team_SLG",
        "team_TeamPayroll", "team_WHIP", "team_run_diff",
        "team_runs_allowed", "team_runs_scored"
    ]

    agg_cols = team_stat_cols + ["team_win_pct"]

    # Aggregate to team-year level
    team_year_df = (
        df.groupby(["team", "year"])[agg_cols]
        .mean()
        .reset_index()
    )

    target = "team_win_pct"
    feature_cols = team_stat_cols

    data = team_year_df.dropna(subset=feature_cols + [target])
    X = data[feature_cols].values
    y = data[target].values

    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)

    X_train, X_test, y_train, y_test = train_test_split(
        X_scaled, y, test_size=0.2, random_state=42
    )

    model = LinearRegression()
    model.fit(X_train, y_train)

    y_pred = model.predict(X_test)

    print("=== Regression Results: Predicting team_win_pct ===")
    print("R^2:", r2_score(y_test, y_pred))
    rmse = mean_squared_error(y_test, y_pred) ** 0.5
    print("RMSE:", rmse)

    # Feature importance
    coef_series = pd.Series(model.coef_, index=feature_cols)
    coef_series = coef_series.sort_values(key=lambda x: x.abs(), ascending=False)

    print("\nTop Feature Importances:")
    print(coef_series)

    # Visualization
    plt.figure(figsize=(8, 10))
    coef_series.head(20).plot(kind="barh")
    plt.gca().invert_yaxis()
    plt.title("Feature Importance: Predicting team_win_pct")
    plt.xlabel("Standardized Coefficient")
    plt.tight_layout()
    plt.savefig("feature_importance_win_pct.png", dpi=300)


if __name__ == "__main__":
    main()
